<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="custom_receipts_for_pos.PrintLastReceiptButton">
        <button t-if="this.pos.config.enable_print_last_receipt"
                type="button"
                class="btn btn-outline-primary btn-lg w-100 mt-2 py-2 px-3 d-flex align-items-center justify-content-center gap-2 fw-semibold rounded-3"
                t-on-click="() => this.onClick()">
            <i class="oi fs-4" data-icon="print" role="img" aria-label="Print Last Receipt"/>
            <span>Print Last Receipt</span>
        </button>
    </t>

    <t t-name="point_of_sale.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <xpath expr="//div" position="inside">
            <PrintLastReceiptButton/>
        </xpath>
    </t>
</templates>